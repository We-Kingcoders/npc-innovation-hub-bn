# =====================================================
# npc-innovation-hub-bn — environment variable template
# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.
# =====================================================

# --- App ---
NODE_ENV=development
PORT=5000
APP_NAME=NPC Innovation Hub
APP_VERSION=1.0.0

# --- URLs ---
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
# Optional: extra allowed CORS origins beyond FRONTEND_URL, comma-separated
# (e.g. a preview deployment alongside the main one). FRONTEND_URL alone is
# enough for a typical single-frontend deployment.
CORS_ORIGINS=

# --- Database (Postgres / Sequelize) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=innovation_hub
DB_USERNAME=postgres
DB_PASSWORD=changeme
# Only used in production (config/config.js -> use_env_variable: 'DB_URL')
DB_URL=postgres://user:password@host:5432/dbname

# --- Auth / JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=24h
REFRESH_SECRET=replace-with-a-different-long-random-string
PASSWORD_EXPIRATION_DAYS=90

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Feature flags ---
ENABLE_GOOGLE_AUTH=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true
MAINTENANCE_MODE=false

# --- Email: SendGrid (used in production) ---
SENDGRID_API_KEY=
SENDGRID_VERIFIED_SENDER=

# --- Email: Gmail/SMTP via Nodemailer (used in development) ---
EMAIL_USER=
EMAIL_PASS=
# Set to 'true' to fall back to an Ethereal test inbox in development
# when EMAIL_USER/EMAIL_PASS are not set
USE_ETHEREAL=false

SUPPORT_EMAIL=support@yourdomain.com
ADMIN_EMAIL=admin@example.com

# --- Cloudinary (file/image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI Assistant (NPC Innovation Hub chatbot, EjoChat-backed) ---
# EJOCHAT_API_KEY and EJOCHAT_BASE_URL were never documented here even
# though a real EJOCHAT_API_KEY already existed in the real .env - this
# fills that gap. AI_PROVIDER exists so a future provider can be swapped
# in without touching call sites (see src/providers/ai/).
AI_PROVIDER=ejochat
EJOCHAT_API_KEY=
EJOCHAT_BASE_URL=https://api.ejolabs.com/api/v1
# Milliseconds before a provider call is aborted
AI_REQUEST_TIMEOUT_MS=15000
# Hard cap on a single incoming chat message's length
AI_MAX_MESSAGE_LENGTH=1000
# Prior turns are capped server-side to this many, regardless of how many
# the client sends - keeps per-request cost bounded and conversations from
# growing unboundedly expensive.
AI_MAX_HISTORY_MESSAGES=8
# Requests per minute, per authenticated user id (or per IP if anonymous)
AI_RATE_LIMIT_PER_MINUTE=15
# Requests per day, same key
AI_DAILY_LIMIT=200
